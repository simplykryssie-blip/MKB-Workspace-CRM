{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "mkb-workspace-crm",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mkb-crm-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mkb-crm-files-dev"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "BACKEND_ENABLED": "false"
  },
  "env": {
    "preview": {
      "name": "mkb-crm-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mkb-crm-preview",
          "database_id": "fa24aaf4-8caa-4652-8b96-fd4704e823bc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "mkb-crm-files-preview"
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "BACKEND_ENABLED": "true",
        "APP_ORIGIN": "https://preview.mkbfinancialgroup.com",
        "EMAIL_FROM": "MKB Financial Group <no-reply@mkbfinancialgroup.com>",
        "APP_ORIGINS": "https://mkb-crm-preview.krystal-21e.workers.dev"
      }
    },
    "production": {
      "name": "mkb-crm-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mkb-crm-production",
          "database_id": "271ff414-afa0-43d6-950b-1f0a0f65d1f6",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "mkb-crm-files-production"
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "BACKEND_ENABLED": "true",
        "APP_ORIGIN": "https://app.mkbfinancialgroup.com",
        "EMAIL_FROM": "MKB Financial Group <no-reply@mkbfinancialgroup.com>",
        "WEBSITE_HOSTS": "mkbfinancialgroup.com,www.mkbfinancialgroup.com",
        "MONARCH_HOSTS": "monarchtaxsuite.com,www.monarchtaxsuite.com",
        "PORTAL_HOSTS": "portal.mkbfinancialgroup.com",
        "PORTAL_ORIGIN": "https://portal.mkbfinancialgroup.com"
      }
    }
  }
}
